# ============================================================
# .env.docker — Misak Dictionary (Docker Compose)
# Copia este archivo a .env.docker y edita los valores.
# .env.docker NUNCA se commitea (ver .gitignore).
# ============================================================

# --- PostgreSQL (host 5434: 5432/5433 ocupados por otros proyectos) ---
POSTGRES_USER=misak
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=misak_dictionary
POSTGRES_PORT=5434

# --- Puertos de host ---
API_PORT=3001
WEB_PORT=8080
PGADMIN_PORT=5051

# --- pgAdmin (perfil tools) ---
PGADMIN_EMAIL=admin@misak.local
PGADMIN_PASSWORD=change-me

# --- Backend (mínimo 32 caracteres; en prod usar secretos reales) ---
JWT_SECRET=dev-only-jwt-secret-min-32-chars-long
JWT_REFRESH_SECRET=dev-only-refresh-secret-min-32-chars

# --- Frontend ---
# Dev: la app en el navegador llama a la API por el puerto del host
VITE_API_URL=http://localhost:3001
# Prod: mismo origen vía proxy Nginx (/api → api:3000)
# VITE_API_URL=/api
CORS_ORIGIN=http://localhost:8080

# --- Zona horaria (Colombia) ---
TZ=America/Bogota
