# ============================================================
# .env.docker — Diccionario Misak (Docker Compose)
# Copia este archivo a .env.docker y edita los valores.
# .env.docker NUNCA se commitea (ver .gitignore).
# ============================================================

# --- PostgreSQL (host 5434: 5432/5433 ocupados por otros proyectos) ---
POSTGRES_USER=misak
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=misak_dictionary
POSTGRES_PORT=5434

# --- Puertos de host ---
API_PORT=3001
WEB_PORT=8080
PGADMIN_PORT=5051

# --- pgAdmin (perfil tools) ---
PGADMIN_EMAIL=admin@misak.local
PGADMIN_PASSWORD=change-me

# --- Backend (mínimo 32 caracteres; en prod usar secretos reales) ---
JWT_SECRET=dev-only-jwt-secret-min-32-chars-long
JWT_REFRESH_SECRET=dev-only-refresh-secret-min-32-chars

# --- Root bootstrap (Spec 002, R-008) — opcional ---
# Si se definen Y no existe ningún super_admin, se crea al arrancar.
# ROOT_BOOTSTRAP_EMAIL=admin@misak.local
# ROOT_BOOTSTRAP_PASSWORD=cambiar-en-produccion-32chars

# --- Rate limiting de auth (Spec 002, R-003) ---
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW=15m

# --- Argon2id (Spec 002, R-004) — defaults OWASP ---
# ARGON2_MEMORY_KIB=65536
# ARGON2_TIME_COST=3
# ARGON2_PARALLELISM=4

# --- Frontend ---
# Dev: la app en el navegador llama a la API por el puerto del host
VITE_API_URL=http://localhost:3001
# Prod (compose.prod.yml): vacío por defecto para mismo origen relativo vía proxy Nginx (/api y /auth → api:3000)
# PROD_VITE_API_URL=
CORS_ORIGIN=http://localhost:8080

# --- Zona horaria (Colombia) ---
TZ=America/Bogota
