#!/bin/sh

set -e

# 1) Check formatting (no changes applied)
if command -v pnpm >/dev/null 2>&1; then
  pnpm -w format:check
else
  npx --no-install prettier --check .
fi

# 2) Lint (root config ignores apps/web-client; that app has its own config)
if command -v pnpm >/dev/null 2>&1; then
  pnpm -w lint
else
  npx --no-install eslint .
fi

# 3) Build the web client to catch build-time issues
if command -v pnpm >/dev/null 2>&1; then
  pnpm build:web
else
  echo "[husky][pre-push] pnpm not found in PATH. Skipping web build. Install pnpm or enable Corepack to enforce builds on push."
fi
