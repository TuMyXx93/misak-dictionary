#!/bin/sh

set -e

# 1) Biome CI — check formatting + lint (no writes, exit on error)
if command -v pnpm >/dev/null 2>&1; then
  pnpm run ci
else
  npx --no-install @biomejs/biome ci .
fi

# 2) Run frontend + backend tests before push
if command -v pnpm >/dev/null 2>&1; then
  pnpm test:all
else
  echo "[husky][pre-push] pnpm not found. Skipping tests."
fi

# 3) Build frontend + backend to catch build-time issues
if command -v pnpm >/dev/null 2>&1; then
  pnpm build:all
else
  echo "[husky][pre-push] pnpm not found. Skipping full build."
fi
