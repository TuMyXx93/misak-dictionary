# ============================================
# 🔒 CONFIGURACIÓN PNPM - NO USAR NPM/YARN
# ============================================
# Este proyecto SOLO funciona con pnpm.
# Usar npm o yarn causará conflictos y congelamiento del sistema.
# Instalación de pnpm: https://pnpm.io/installation
# ============================================

# Bloquear npm y yarn (solo permitir pnpm)
engine-strict=true

# Configuración de dependencias peer
auto-install-peers=true
strict-peer-dependencies=false

# Hoisting optimizado para monorepo
shamefully-hoist=false
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
public-hoist-pattern[]=*typescript*

# Seguridad y performance
prefer-frozen-lockfile=true
