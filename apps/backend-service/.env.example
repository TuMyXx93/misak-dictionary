# ================================================
# Backend Service — Environment Variables
# Diccionario Misak (Wamtɵrmarɵpik)
# ================================================

# -------------------- Server --------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# -------------------- Database --------------------
# PostgreSQL 18.1+ connection string (local host: 5432 | Docker stack: 5434)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/misak_dictionary?schema=public

# -------------------- JWT Authentication --------------------
# Minimum 32 characters per secret (HS256 + opaque HttpOnly refresh cookie)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-token-change-this
JWT_REFRESH_EXPIRES_IN=7d

# -------------------- Argon2id Password Hashing --------------------
# OWASP Password Storage recommended parameters (@node-rs/argon2)
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# -------------------- Security & Rate Limiting --------------------
# CORS allowed origins (comma-separated)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Global fallback rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_TIMEWINDOW=15m

# Differentiated rate limiting buckets (per IP or authenticated userId behind NAT/tunnel)
PUBLIC_RATE_LIMIT_MAX=300
PUBLIC_RATE_LIMIT_WINDOW=1m
ADMIN_RATE_LIMIT_MAX=600
ADMIN_RATE_LIMIT_WINDOW=1m
STREAM_RATE_LIMIT_MAX=600
STREAM_RATE_LIMIT_WINDOW=1m

# Strict auth endpoint rate limiting (POST /auth/login)
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW=15m

# -------------------- Root Bootstrap (First Startup Only) --------------------
# Optional: creates initial super_admin if no users exist in the database
ROOT_BOOTSTRAP_EMAIL=
ROOT_BOOTSTRAP_PASSWORD=

# -------------------- Logging --------------------
# Options: error, warn, info, debug, trace
LOG_LEVEL=info

# -------------------- Seed Admin (Optional — prisma/seed.ts) --------------------
# Si se define (>= 15 caracteres), asigna esta clave temporal al usuario 'admin';
# si se omite en desarrollo, seed.ts genera una contraseña aleatoria segura de un solo uso.
SEED_ADMIN_PASSWORD=
