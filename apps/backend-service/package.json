{
  "name": "@misak/backend-service",
  "version": "0.4.0-alpha.0",
  "type": "module",
  "description": "Backend service para Diccionario Cultural Misak - Week 3",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "lint": "biome lint src/",
    "lint:fix": "biome lint --write src/",
    "format": "biome format --write \"src/**/*.ts\" \"prisma/**/*.ts\"",
    "format:check": "biome format \"src/**/*.ts\" \"prisma/**/*.ts\""
  },
  "keywords": [
    "misak",
    "diccionario",
    "backend",
    "fastify",
    "prisma",
    "postgresql"
  ],
  "author": "Tumi-dev",
  "license": "ISC",
  "dependencies": {
    "@fastify/auth": "^5.0.1",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^9.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/sensible": "^6.0.1",
    "@fastify/static": "^8.0.2",
    "@prisma/adapter-pg": "7.0.1",
    "@prisma/client": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "8.16.3",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@prisma/client-runtime-utils": "7.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^24.10.1",
    "@types/pg": "8.15.6",
    "@vitest/coverage-v8": "^4.0.14",
    "pino-pretty": "^13.1.2",
    "prisma": "^7.0.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "^4.0.14"
  },
  "engines": {
    "node": ">=22.20.0",
    "pnpm": ">=10.20.0"
  }
}
