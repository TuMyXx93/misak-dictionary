# URL base del backend API.
# - En desarrollo local (Vite proxy automático): opcional o http://localhost:3000
# - En Docker Compose: http://localhost:3001
# - En producción: URL pública del backend o relativo si corre tras Nginx
VITE_API_URL=http://localhost:3000
