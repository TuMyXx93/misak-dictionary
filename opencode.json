{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "share": "manual",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "formatter": {
    "biome": {
      "command": ["pnpm", "exec", "biome", "format", "--write", "$FILE"],
      "extensions": [".js", ".ts", ".cjs", ".mjs", ".jsx", ".tsx", ".json", ".jsonc", ".css"]
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "engram": {
      "type": "local",
      "command": ["engram", "mcp", "--tools=agent"],
      "enabled": true
    },
    "misak-postgres": {
      "type": "local",
      "command": ["sh", "scripts/mcp/misak-postgres.sh"],
      "enabled": true
    }
  },
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "skill": {
      "*": "allow"
    }
  },
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", ".git/**", "coverage/**", ".next/**"]
  }
}
