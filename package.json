{
  "name": "tumidev",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "main": "index.js",
  "scripts": {
    "preinstall": "node scripts/check-package-manager.js",
    "sync-pnpm": "node scripts/sync-pnpm-version.js",
    "test": "pnpm --filter web-client test",
    "test:ui": "pnpm --filter web-client test:ui",
    "test:coverage": "pnpm --filter web-client test:coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "dev:web": "pnpm --filter web-client dev",
    "build:web": "pnpm --filter web-client build",
    "preview:web": "pnpm --filter web-client preview",
    "lint:web": "pnpm --filter web-client lint"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.18.2",
  "engines": {
    "node": ">=22.19.0",
    "pnpm": ">=10.18.2",
    "npm": "please-use-pnpm",
    "yarn": "please-use-pnpm"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.5.2",
    "eslint": "^9.36.0",
    "husky": "^9.0.0",
    "lint-staged": "^16.2.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1"
  },
  "lint-staged": {
    "apps/web-client/**/*.{js,jsx,ts,tsx}": [
      "pnpm --filter web-client exec eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html,yml,yaml}": [
      "prettier --write"
    ]
  }
}
