{
  "name": "misak-dictionary",
  "private": true,
  "version": "0.5.0-alpha.0",
  "type": "module",
  "description": "Monorepo oficial del Diccionario Misak (Wamtɵrmarɵpik)",
  "scripts": {
    "preinstall": "node scripts/check-package-manager.cjs && node scripts/check-node-version.cjs",
    "sync-pnpm": "node scripts/sync-pnpm-version.js",
    "test": "pnpm --filter web-client test",
    "test:ui": "pnpm --filter web-client test:ui",
    "test:coverage": "pnpm --filter web-client test:coverage",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:runtime": "node scripts/check-node-version.cjs",
    "check:fix": "biome check --write .",
    "ci": "biome ci .",
    "prepare": "husky",
    "dev:web": "pnpm --filter web-client dev",
    "build:web": "pnpm --filter web-client build",
    "build:analyze": "pnpm --filter web-client build:analyze",
    "preview:web": "pnpm --filter web-client preview",
    "dev:backend": "pnpm --filter @misak/backend-service dev",
    "build:backend": "pnpm --filter @misak/backend-service build",
    "start:backend": "pnpm --filter @misak/backend-service start",
    "prisma:generate": "pnpm --filter @misak/backend-service prisma:generate",
    "prisma:studio": "pnpm --filter @misak/backend-service prisma:studio",
    "db:push": "pnpm --filter @misak/backend-service db:push",
    "release": "commit-and-tag-version",
    "release:alpha": "commit-and-tag-version --prerelease alpha",
    "release:beta": "commit-and-tag-version --prerelease beta",
    "release:dry": "commit-and-tag-version --dry-run",
    "release:first": "commit-and-tag-version --first-release",
    "engram:search": "engram search",
    "engram:context": "engram context misak-dictionary",
    "engram:stats": "engram stats",
    "engram:sync": "engram sync",
    "engram:conflicts": "engram conflicts scan --project misak-dictionary",
    "agents:sync": "node scripts/agents/sync-antigravity.mjs",
    "agents:check": "node scripts/agents/sync-antigravity.mjs --check"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=24.15.0",
    "pnpm": ">=10.20.0",
    "npm": "please-use-pnpm",
    "yarn": "please-use-pnpm"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.6",
    "@commitlint/config-conventional": "20.4.3",
    "@types/node": "^24.10.1",
    "commit-and-tag-version": "12.6.1",
    "commitlint": "20.4.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.2",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,jsx,tsx,json,jsonc,css}": [
      "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
    ],
    ".opencode/**/*.md": [
      "node scripts/agents/sync-antigravity.mjs --check"
    ]
  },
  "pnpm": {
    "overrides": {
      "fast-jwt": "6.2.0"
    }
  }
}
